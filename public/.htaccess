# ------------------------------------------
# ✅ Force HTTPS and WWW consistency
# ------------------------------------------
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [L,R=301]

# ------------------------------------------
# ✅ Consolidated duplicate-content redirects
# ------------------------------------------
# Plain mod_alias `Redirect` directives here were being bypassed by the
# known-routes 404 catch-all below (these two legacy paths aren't in that
# whitelist, so requests fell straight through to R=404 before mod_alias
# ever redirected them). Using RewriteRule instead, ahead of the catch-all,
# makes the redirect win explicitly.
RewriteRule ^laptop-repair/?$ /laptop-screen-repair/ [R=301,L]
RewriteRule ^it-support/?$ /business-it-support/ [R=301,L]

# ------------------------------------------
# ✅ React Router / SPA Support
# ------------------------------------------
# Known app routes serve index.html normally (200). Anything else falls
# through to the 404 ErrorDocument below, which also serves index.html
# (so React Router renders the NotFound page) but with a real 404 status —
# without this split, every unmatched URL returned 200, which Google flags
# as a soft 404 since the URL clearly isn't a real page.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(js|css|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot|ico|json|txt|xml|pdf|zip)$
# BEGIN generated known-routes (kept in sync with scripts/routes.mjs by generate-sitemap.mjs)
RewriteCond %{REQUEST_URI} !^/(about|services|pricing|contact|recycling|terms|privacy-policy|mail-in-form|blog(/[^/]+)?|graphic-design|remote-assistance|ps5-hdmi-repair|xbox-hdmi-repair|laptop-screen-repair|ssd-upgrades|virus-malware-removal|business-it-support|data-recovery|custom-gaming-pc|water-damage-repair|smartphone-screen-repair-charlotte|tablet-ipad-repair|smart-tv-repair|printer-router-repair|pcb-micro-soldering|appliance-electronics-repair|nintendo-switch-repair|locations|charlotte-computer-repair|matthews-computer-repair|indian-trail-computer-repair|mint-hill-computer-repair|monroe-computer-repair|ballantyne-computer-repair|pineville-computer-repair|waxhaw-computer-repair|weddington-computer-repair|stallings-computer-repair)/?$
# END generated known-routes
RewriteRule ^ - [R=404,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(js|css|png|jpg|jpeg|gif|svg|webp|woff|woff2|ttf|eot|ico|json|txt|xml|pdf|zip)$
RewriteRule ^ index.html [L]

# ------------------------------------------
# ✅ GZIP Compression
# ------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE image/webp
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------
# ✅ Brotli Compression (if available)
# ------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/plain
  AddOutputFilterByType BROTLI_COMPRESS text/html
  AddOutputFilterByType BROTLI_COMPRESS text/xml
  AddOutputFilterByType BROTLI_COMPRESS text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json
  AddOutputFilterByType BROTLI_COMPRESS application/rss+xml
  AddOutputFilterByType BROTLI_COMPRESS application/atom+xml
  AddOutputFilterByType BROTLI_COMPRESS image/webp
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
  AddOutputFilterByType BROTLI_COMPRESS font/woff
  AddOutputFilterByType BROTLI_COMPRESS font/woff2
</IfModule>

# ------------------------------------------
# ✅ Browser Caching (Expires Headers)
# ------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 1 day"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ------------------------------------------
# ✅ Cache-Control Headers & Preloads
# ------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|css|js|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.(css)$">
    Header add Link "</assets/css/index.css>; rel=preload; as=style"
  </FilesMatch>
  <FilesMatch "\.(js)$">
    Header add Link "</assets/js/index.js>; rel=preload; as=script"
  </FilesMatch>
</IfModule>

# ------------------------------------------
# ✅ Security Headers
# ------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' *.googletagmanager.com *.google-analytics.com *.googleadservices.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src 'self' fonts.gstatic.com; img-src 'self' data: *.google-analytics.com *.googletagmanager.com *.pexels.com; connect-src 'self' *.google-analytics.com analytics.google.com *.analytics.google.com *.googletagmanager.com kortech-mailin-form.mskorhan.workers.dev; frame-src 'self' *.google.com"
</IfModule>

# ------------------------------------------
# ✅ Disable Directory Listing
# ------------------------------------------
Options -Indexes

# ------------------------------------------
# ✅ Prevent Access to Sensitive Files
# ------------------------------------------
<FilesMatch "\.(htaccess|htpasswd|env|git|gitignore|DS_Store|ini|log|conf|sql|sh)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# ------------------------------------------
# ✅ Custom 404 Page
# ------------------------------------------
# Serves the SPA shell so React Router renders the NotFound page/copy,
# while Apache still reports a real 404 status to crawlers.
ErrorDocument 404 /index.html